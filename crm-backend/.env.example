# --- Neon PostgreSQL ---------------------------------------------------------
# App connection: use the POOLED string (host contains "-pooler").
DATABASE_URL=postgresql://neondb_owner:npg_Xgr4NSvVB5JT@ep-round-dew-bjbtdewu-pooler.c-3.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Migrations: use the DIRECT string (same host without "-pooler"). Optional but recommended.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]

# --- Session cookie ----------------------------------------------------------
COOKIE_NAME=session_id
COOKIE_SECURE=false          # set true in staging/production (HTTPS)
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=72

# --- Login protection --------------------------------------------------------
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=10

# --- First admin (used only by: python -m app.scripts.seed) -------------------
FIRST_ADMIN_EMAIL=admin@yourcompany.com
FIRST_ADMIN_PASSWORD=ChangeMe-Please-123
FIRST_ADMIN_NAME=System Admin
